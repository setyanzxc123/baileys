# Server Configuration
PORT=3001
# Bind address. Default 127.0.0.1 karena konsumen API berjalan di mesin yang sama.
# Gunakan 0.0.0.0 hanya bila konsumen berada di mesin lain dalam jaringan terpercaya.
HOST=127.0.0.1
NODE_ENV=development
SERVICE_NAME=WhatsApp Gateway

# Security API Key for protected endpoints
# WAJIB diisi. Buat kunci kuat, contoh:
#   node -e "console.log('gw_' + require('crypto').randomBytes(32).toString('hex'))"
API_KEY=ubah-dengan-kunci-rahasia-yang-panjang

# WhatsApp Session Storage Directory
SESSION_DIR=./sessions/primary

# Rate Limiting (jaring pengaman gateway; kebijakan detail tetap di app konsumen)
RATE_LIMIT_SEND_PER_MINUTE=60
RATE_LIMIT_PAIR_PER_MINUTE=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5

# Batas pengirim global (sliding window) untuk menurunkan sinyal spam WhatsApp
SENDER_MAX_PER_HOUR=30
SENDER_MAX_PER_DAY=200

# Circuit breaker sinyal 463 (restriction/tctoken): pause kirim bertingkat
# BREAKER_463_ENABLED=false untuk menonaktifkan
BREAKER_463_WINDOW_MS=900000
# Set true jika gateway berjalan di belakang nginx/reverse proxy (agar limit per-IP akurat)
TRUST_PROXY=false

# Logger level aplikasi ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info
# Logger level internal Baileys (set debug/trace hanya untuk troubleshooting protokol)
BAILEYS_LOG_LEVEL=silent

# Synchronous Server ACK (Centang 1) Await
# Menahan HTTP response sampai server WhatsApp mengonfirmasi penerimaan stanza
SERVER_ACK_ENABLED=true
SERVER_ACK_TIMEOUT_MS=3000

# Idempotency-Key (pencegahan kirim ganda saat konsumen retry)
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_KEYS=1000

# Audit log pengiriman append-only (rekonsiliasi status, tanpa konten OTP)
# Nomor telepon disimpan ter-mask; ref_id tetap disimpan untuk penelusuran
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=./logs/audit.jsonl
AUDIT_INDEX_MAX=2000

# Cache resolusi onWhatsApp per nomor (kurangi query berulang ke server WA)
RECIPIENT_CACHE_TTL_SECONDS=10800
RECIPIENT_CACHE_NEGATIVE_TTL_SECONDS=300

# OTP Anti-Spam (Rotasi Template & Unique Ref Hash)
OTP_DEFAULT_EXPIRY_MINUTES=5
OTP_INCLUDE_REF=true

