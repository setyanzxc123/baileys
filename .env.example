# Server Configuration
PORT=3001
NODE_ENV=development

# Security API Key for protected endpoints
# WAJIB diisi. Buat kunci kuat, contoh:
#   node -e "console.log('gw_' + require('crypto').randomBytes(32).toString('hex'))"
API_KEY=ubah-dengan-kunci-rahasia-yang-panjang

# WhatsApp Session Storage Directory
SESSION_DIR=./sessions/primary

# Rate Limiting (jaring pengaman gateway; kebijakan detail tetap di app konsumen)
RATE_LIMIT_SEND_PER_MINUTE=60
RATE_LIMIT_PAIR_PER_MINUTE=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
# Batas penerima per permintaan POST /send-bulk (pecah batch bila lebih)
BULK_MAX_RECIPIENTS=100
# Set true jika gateway berjalan di belakang nginx/reverse proxy (agar limit per-IP akurat)
TRUST_PROXY=false

# Logger level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=silent
